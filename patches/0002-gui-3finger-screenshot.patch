+// ---------------------------------------------------------------------------
+// [X625D patch] Multi-touch contact tracking for 3-finger gestures.
+// The stock event loop only follows a single pointer stream, so we keep our
+// own per-slot bookkeeping here (Protocol B: ABS_MT_SLOT + ABS_MT_TRACKING_ID)
+// and expose the results so the GUI can detect a multi-finger swipe.
+#define MT_GESTURE_MAX_SLOTS 16
+static int s_mt_slot = 0;                    // current ABS_MT_SLOT
+static int s_mt_slot_down[MT_GESTURE_MAX_SLOTS]; // per-slot contact state
+static int s_mt_contacts = 0;                // active contacts right now
+static int s_mt_max_contacts = 0;            // max simultaneous contacts this gesture
+
+static void mt_gesture_set_slot(int slot)
+{
+    if (slot < 0)                 slot = 0;
+    if (slot >= MT_GESTURE_MAX_SLOTS) slot = MT_GESTURE_MAX_SLOTS - 1;
+    s_mt_slot = slot;
+}
+
+static void mt_gesture_down(int slot)
+{
+    if (slot < 0 || slot >= MT_GESTURE_MAX_SLOTS) return;
+    if (!s_mt_slot_down[slot]) {
+        s_mt_slot_down[slot] = 1;
+        s_mt_contacts++;
+        if (s_mt_contacts > s_mt_max_contacts)
+            s_mt_max_contacts = s_mt_contacts;
+    }
+}
+
+static void mt_gesture_up(int slot)
+{
+    if (slot < 0 || slot >= MT_GESTURE_MAX_SLOTS) return;
+    if (s_mt_slot_down[slot]) {
+        s_mt_slot_down[slot] = 0;
+        if (s_mt_contacts > 0)
+            s_mt_contacts--;
+    }
+}
+
+// highest simultaneous contact count seen in the current/last gesture
+int ev_mt_max_contacts(void)
+{
+    return s_mt_max_contacts;
+}
+
+// true while at least one finger is still on the screen
+int ev_mt_gesture_active(void)
+{
+    return s_mt_contacts > 0;
+}
+
+// reset the bookkeeping after the GUI consumed the gesture
+void ev_mt_gesture_clear(void)
+{
+    s_mt_max_contacts = 0;
+}
+
