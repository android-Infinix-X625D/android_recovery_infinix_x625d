diff --git a/twcommon.h b/twcommon.h
index 0895428..ea971f8 100644
--- a/twcommon.h
+++ b/twcommon.h
@@ -19,10 +19,22 @@
 #ifndef TWCOMMON_HPP
 #define TWCOMMON_HPP
 
+#include <stdio.h>
+#include <time.h>
+
 #ifdef __cplusplus
 extern "C" {
 #endif
 
+// Monotonic timestamp prefix for boot phase measurements. LOGTIME lines make
+// the recovery log show how long each startup step actually took.
+static inline void tw_log_stamp(void) {
+	struct timespec tw_ts;
+	clock_gettime(CLOCK_MONOTONIC, &tw_ts);
+	printf("[%6ld.%03ld] ", (long)(tw_ts.tv_sec % 100000), (long)(tw_ts.tv_nsec / 1000000));
+}
+#define LOGTIME(...) do { tw_log_stamp(); printf("I:" __VA_ARGS__); } while (0)
+
 #ifndef BUILD_TWRPTAR_MAIN
 #include "gui/gui.h"
 #define LOGERR(...) gui_print_color("error", "E:" __VA_ARGS__)
