+// [X625D patch] Realtime battery/charge status: read the sysfs nodes directly
+// (throttled to ~250 ms) instead of relying on the 1-Hz data-manager cache, and
+// request a full redraw whenever the percentage or the charge state changed.
+// This makes plugging/unplugging the cable visible immediately, without having
+// to touch the UI first.
+int GUIBattery::Update(void)
+{
+	if (!isConditionTrue())
+		return 0;
+
+	struct timeval curTime;
+	gettimeofday(&curTime, NULL);
+	unsigned long long nowMs = (unsigned long long)curTime.tv_sec * 1000
+				 + curTime.tv_usec / 1000;
+	if (mLastPollMs && nowMs - mLastPollMs < 250)
+		return 0;
+	mLastPollMs = nowMs;
+
+	FILE* fp = fopen("/sys/class/power_supply/battery/capacity", "rt");
+	if (!fp)
+		return 0;
+	char buf[8] = "";
+	int percent = fgets(buf, sizeof(buf), fp) ? atoi(buf) : -1;
+	fclose(fp);
+	if (percent < 0)
+		return 0;
+	if (percent > 100)
+		percent = 100;
+
+	fp = fopen("/sys/class/power_supply/battery/status", "rt");
+	int charging = 0;
+	if (fp) {
+		char s[4] = "";
+		charging = (fgets(s, sizeof(s), fp) && s[0] == 'C') ? 1 : 0;
+		fclose(fp);
+	}
+
+	if (percent == mLastPercent && charging == mLastCharge)
+		return 0;
+
+	mLastPercent = percent;
+	mLastCharge = charging;
+	DataManager::SetValue("tw_battery", percent, 0);
+	DataManager::SetValue("charging_now", charging ? 1 : 0, 0);
+	char tmp[16];
+	snprintf(tmp, sizeof(tmp), "%i%%%c", percent, charging ? '+' : ' ');
+	DataManager::SetValue("tw_battery_charge", tmp, 0);
+
+	if (Render() == 0)
+		return 2;
+	return 0;
+}
