+// [X625D patch] Realtime battery/charge status: poll the 1-Hz cached data
+// manager values here and request a full redraw when the percentage or the
+// charge state changed, instead of only changing state together with the next
+// random UI event (plugging/unplugging the cable was invisible until the user
+// touched some menu).
+int GUIBattery::Update(void)
+{
+	if (!isConditionTrue())
+		return 0;
+
+	int percent = DataManager::GetIntValue("tw_battery");
+	int charging = DataManager::GetIntValue("charging_now");
+	if (percent != mLastPercent || charging != mLastCharge) {
+		mLastPercent = percent;
+		mLastCharge = charging;
+		if (Render() == 0)
+			return 2;
+	}
+	return 0;
+}
