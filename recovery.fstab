# TWRP fstab untuk Infinix Hot 7 Pro X625D (MT6765, Android 9, A-only, FBE)
# Source: stock /etc/recovery.fstab from X625D-H623L-P-201015V258
# Format TWRP: <mount_point> <fstype> <device> [flags]

/boot        emmc   /dev/block/platform/bootdevice/by-name/boot
/recovery    emmc   /dev/block/platform/bootdevice/by-name/recovery
/system      ext4   /dev/block/platform/bootdevice/by-name/system   flags=display="System";backup=1;wipeduringfactoryreset
/vendor      ext4   /dev/block/platform/bootdevice/by-name/vendor   flags=display="Vendor";backup=1;wipeduringfactoryreset
/data        ext4   /dev/block/platform/bootdevice/by-name/userdata   flags=fileencryption=aes-256-cts;forcefdeorfbe=/dev/block/platform/bootdevice/by-name/metadata;storage;wipeingui
# /metadata raw 32MB (scatter SYS31) backing forcefdeorfbe, NOT ext4 - don't mount it, just reference it from the /data flags above
/cache       ext4   /dev/block/platform/bootdevice/by-name/cache   flags=display="Cache";backup=1;wipeduringfactoryreset;wipeingui
/tranfs      ext4   /dev/block/platform/bootdevice/by-name/tranfs   flags=display="Tranfs";backup=1;wipeingui;nofail
# the scatter has NO by-name/sdcard partition - MT6765 MicroSD via mmcblk1, voldmanaged
/external_sd auto   /dev/block/mmcblk1p1   flags=display="MicroSD";storage;wipeingui;removable;nofail;voldmanaged=sdcard1:auto
/external_sd auto   /dev/block/mmcblk1     flags=display="MicroSD";storage;wipeingui;removable;nofail;voldmanaged=sdcard1:auto
/usb-otg     auto   /dev/block/sda1   flags=display="OTG";storage;wipeingui;removable;nofail;voldmanaged=usbotg:auto
/usb-otg     auto   /dev/block/sda    flags=display="OTG";storage;wipeingui;removable;nofail;voldmanaged=usbotg:auto
/logo        emmc   /dev/block/platform/bootdevice/by-name/logo
/expdb       emmc   /dev/block/platform/bootdevice/by-name/expdb
/nvram       emmc   /dev/block/platform/bootdevice/by-name/nvram   flags=display="Nvram";backup=1
/nvdata      ext4   /dev/block/platform/bootdevice/by-name/nvdata   flags=display="Nvdata";backup=1;nofail
/persist     ext4   /dev/block/platform/bootdevice/by-name/persist flags=display="Persist";backup=1;nofail
