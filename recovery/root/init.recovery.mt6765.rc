# init.recovery.mt6765.rc - USB configfs for X625D (taken from the stock recovery.img)
# Fix ADB on OrangeFox: stock only starts adbd when ro.debuggable=0,
# on Fox (eng, debuggable=1) adbd never starts -> add the ro.debuggable=1 trigger
# Fix MTP: stock only creates ffs.adb -> TWRP logs "could not open MTP driver, errno: 2".
# TWRP R11 MtpServer uses the functionfs transport (ffs.mtp, /dev/usb-ffs/mtp,
# flagged sys.usb.ffs.mtp.ready=1), NOT legacy mtp.gs0 (/dev/mtp_usb).
# If mtp.gs0 is linked, the PC sees an MTP interface but nothing
# answers -> repeated USB resets, mtp-detect "failed to open session".
# So the mtp_adb configuration links: ffs.adb + ffs.mtp.
# TW_EXCLUDE_DEFAULT_USB_INIT=true, so this file owns the gadget; keep it enabled.

on init
    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mkdir /dev/usb-ffs/mtp 0770 shell shell
    mount functionfs mtp /dev/usb-ffs/mtp uid=2000,gid=2000
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.config mtp,adb

on property:ro.debuggable=0
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

on property:ro.debuggable=1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

on property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state "mtp,adb"

on property:sys.usb.ffs.mtp.ready=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state "mtp,adb"

on post-fs
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

# MT6765 FDE decrypt stack (follows the working Xiaomi cactus pattern, same SoC):
# hwservicemanager + servicemanager must run before keymaster-3-0,
# keymaster-3-0 + teei_daemon start on ro.crypto.state=encrypted
# stop after twrp.decrypt.done=true (saves RAM and avoids hangs).
on init
    start hwservicemanager
    start servicemanager

service hwservicemanager /sbin/hwservicemanager
    user root
    group root
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

service servicemanager /sbin/servicemanager
    user root
    group root
    disabled
    onrestart setprop servicemanager.ready false
    seclabel u:r:recovery:s0

service keymaster-3-0 /sbin/android.hardware.keymaster@3.0-service
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:ro.crypto.state=encrypted
    start teei_daemon
    start keymaster-3-0

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop keymaster-3-0

# TEE microtrust: teei_daemon MUST run before FDE decrypt.
# Without this, keymaster hangs in the kernel (D-state process, log "Decrypt took too long")
# because nothing serves /dev/teei_client. On a normal boot this daemon
# started by vendor microtrust.rc (service teei_daemon, class core, user/group system).
# NOTE: use the /sbin/teei_daemon copy (stock blob whose INTERP already
# patched /system/bin/linker64 -> /sbin/linker64). The stock INTERP does not run inside
# recovery: the ramdisk has no /system/bin/linker64 (the recovery linker lives in
# /sbin/linker64), causing execve ENOENT + a crash loop every 5 seconds
# ("init.svc.teei_daemon=restarting", slow boot, dead TEE, failed decrypt).
# /vendor/bin is NOT used: the stock vendor partition mount hides it at boot.
# DECRYPT STATUS (2026-09-19, live verification, repack-4e318eb build):
# FDE footer read, UT HAL loaded, teei_daemon RUNNING as system and
# talking to the TEE (tz_vfs_read) and thh dirs replicated — result unchanged:
# "Error starting keymaster signature transaction: -1000" untuk
# default_password or the correct PIN. System (same/orange boot state) CAN
# unwrap -> this rejection is specific to the recovery context (microtrust TA policy),
# missing uids/files either. CONCLUSION: FDE decryption of X625D via this custom
# recovery is IMPOSSIBLE. teei stays started so keymaster fails FAST (-1000),
# not a D-state kernel hang (what used to slow booting down).
# The supported path: DFE (dfe_patch service, proven working) + unencrypted data.
service teei_daemon /sbin/teei_daemon
    class core
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

on boot
    # /sbin in this build ships mode 750 root:root - without the traverse bit, user
    # system cannot exec anything inside it (EACCES). Open it so the
    # user system (teei) to run. Verified live over adb.
    chmod 755 /sbin
    chmod 0755 /sbin/teei_daemon
    chmod 0755 /sbin/linker64 /sbin/linker
    chmod 0755 /sbin/libc.so /sbin/libm.so /sbin/libdl.so
    chmod 0755 /sbin/libc++.so /sbin/liblog.so /sbin/libcutils.so
    chmod 0660 /dev/teei_client
    chown system system /dev/teei_client
    chmod 0660 /dev/teei_config
    chown system system /dev/teei_config
    chmod 0660 /dev/tee0
    chown system keystore /dev/tee0
    chmod 0660 /dev/tz_vfs
    chown system system /dev/tz_vfs
    chmod 0660 /dev/teei_fp
    chown system system /dev/teei_fp
    chmod 0660 /dev/ut_keymaster
    chown system keystore /dev/ut_keymaster
    chmod 0660 /dev/rpmb0
    chown system system /dev/rpmb0
    # Other TEE nodes like stock microtrust.rc (defensive: init moves on if absent)
    chmod 0660 /dev/emmcrpmb0
    chown system system /dev/emmcrpmb0
    chmod 0660 /dev/utr_tui
    chown system system /dev/utr_tui
    chown system system /sys/bus/platform/devices/utos/load_ut_drv
    chown system system /sys/bus/platform/devices/utos/unload_ut_drv
    chown system system /sys/bus/platform/devices/utos/notify_ree_dci_handler
    start teei_daemon

# Auto DFE: stop the OS from re-encrypting /data (idempotent, safe on every boot).
# Run as a oneshot service (NOT `exec` in `on boot`): proven in
# build a512309: `exec -- /sbin/dfe_patch.sh` never ran (no log at all),
# /tmp/dfe_patch.log) while the oneshot service (dt2w_enable) runs normally.
service dfe_patch /sbin/dfe_patch.sh
    disabled
    oneshot
    seclabel u:r:recovery:s0

on boot
    start dfe_patch

# DT2W (NVT36xxx-ts / NT36672A, MT6765) — based on the reference module
# android_device_infinix_X625D-module_dt2w (findings from ADB debugging):
#  - Write node = /proc/gesture_function (NOT /proc/gesture_state, that is read-only status).
#  - Format = EXACTLY 3 bytes with no newline, e.g. "cc1" = enable Double Tap
#    (dmesg: "CTP-gesture buff 0:c 1:c 2:1!!!").
#  - NEVER write "cc:1" / "w:1;m:1;c:1;cc:1;" (colon/comma format) — it hangs the driver.
# Run via a oneshot service (/sbin/dt2w_enable.sh script) because the proc node
# the node only appears after driver probe (~1.8s+): a plain `write` in `on boot` may run
# BEFORE the node exists, then fail silently without retry. The service does not block boot.
# Verify with: adb shell "cat /proc/gesture_state; cat /tmp/dt2w.log"
# (should contain "cc:1").
service dt2w_enable /sbin/dt2w_enable.sh
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Triggered when the recovery is already running (NOT on boot): the recovery binary disables
# gesture (ctp_gesture_fun_enable=0) at ~2.6s. Enabling must happen AFTER that,
# script still sleeps+verifies+rewrites. The seclabel is REQUIRED — without it
# init never registers the service in this build (debug result: a service without seclabel
# simply never shows up in init.svc.*).
on property:init.svc.recovery=running
    start dt2w_enable
