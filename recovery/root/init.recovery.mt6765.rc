# init.recovery.mt6765.rc - USB configfs for X625D (taken from the stock recovery.img)
# Fix ADB on OrangeFox: stock only starts adbd when ro.debuggable=0,
# on Fox (eng, debuggable=1) adbd never starts -> add the ro.debuggable=1 trigger
# Fix MTP: stock only creates ffs.adb -> TWRP logs "could not open MTP driver, errno: 2".
# TWRP R11 MtpServer uses the functionfs transport (ffs.mtp, /dev/usb-ffs/mtp,
# flagged sys.usb.ffs.mtp.ready=1), NOT legacy mtp.gs0 (/dev/mtp_usb).
# If mtp.gs0 is linked, the PC sees an MTP interface but nothing
# answers -> repeated USB resets, mtp-detect "failed to open session".
# So the mtp_adb configuration links: ffs.adb + ffs.mtp.
# TW_EXCLUDE_DEFAULT_USB_INIT=true, so this file owns the gadget; keep it enabled.

on init
    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mkdir /dev/usb-ffs/mtp 0770 shell shell
    mount functionfs mtp /dev/usb-ffs/mtp uid=2000,gid=2000
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.config mtp,adb

on property:ro.debuggable=0
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

on property:ro.debuggable=1
    write /sys/class/udc/musb-hdrc/device/cmode 2
    start adbd

on property:sys.usb.ffs.ready=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state "mtp,adb"

on property:sys.usb.ffs.mtp.ready=1
    write /config/usb_gadget/g1/UDC "none"
    rm /config/usb_gadget/g1/configs/b.1/f1
    rm /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC "musb-hdrc"
    setprop sys.usb.state "mtp,adb"

on post-fs
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

# TEE microtrust: teei_daemon MUST run before FDE decrypt.
# Without this, keymaster hangs in the kernel (D-state process, log "Decrypt took too long")
# because nothing serves /dev/teei_client. On a normal boot this daemon
# started by vendor microtrust.rc (service teei_daemon, class core, user/group system).
service teei_daemon /vendor/bin/teei_daemon
    class core
    user system
    group system
    disabled

on boot
    chmod 0660 /dev/teei_client
    chown system system /dev/teei_client
    chmod 0660 /dev/teei_config
    chown system system /dev/teei_config
    chmod 0660 /dev/tee0
    chown system keystore /dev/tee0
    chmod 0660 /dev/tz_vfs
    chown system system /dev/tz_vfs
    chmod 0660 /dev/teei_fp
    chown system system /dev/teei_fp
    chmod 0660 /dev/ut_keymaster
    chown system keystore /dev/ut_keymaster
    chmod 0660 /dev/rpmb0
    chown system system /dev/rpmb0
    chown system system /sys/bus/platform/devices/utos/load_ut_drv
    chown system system /sys/bus/platform/devices/utos/unload_ut_drv
    chown system system /sys/bus/platform/devices/utos/notify_ree_dci_handler
    start teei_daemon

# Auto DFE: stop the OS from re-encrypting /data (idempotent, safe on every boot).
# This script checks vendor fstab.mt6765, only rewriting forcefdeorfbe= -> encryptable=
# when the flag is still there. It never breaks boot (always exits 0).
on boot
    exec -- /sbin/dfe_patch.sh

# experimental DT2W: stock values with gestures on = w:1;m:1;c:1;cc:1; (cc = double-tap)
# Written twice (boot + post-fs-data) because the proc node only appears after the ~1.8s driver probe.
# If the driver rejects it, check dmesg for "bad command format" - the init write never fails boot.
on boot
    chmod 0666 /proc/gesture_state
    write /proc/gesture_state "w:1;m:1;c:1;cc:1;"

on property:sys.boot_from_recovery=1
    chmod 0666 /proc/gesture_state
    write /proc/gesture_state "w:1;m:1;c:1;cc:1;"
